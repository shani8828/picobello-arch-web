---
// 15 Phase 1 timeline. Source: arch/15-phase1-timeline.txt
import Takeaway from '../components/Takeaway.astro';
import Icon from '../components/Icon.astro';
import Pill from '../components/Pill.astro';
import Figure from '../components/diagram/Figure.astro';
import Gantt from '../components/diagram/Gantt.astro';

const milestones: [string, string, string][] = [
  ['M0', '5 Nov', 'Architecture approved; database host decided'],
  ['M1', '15 Nov', 'Staff can log in and see both houses and all units'],
  ['M2', '29 Nov', 'A real booking in Lodgify (test property) appears in the Back Office within a minute; an owner reservation appears as a block in Lodgify'],
  ['M3', '13 Dec', 'Every booking and owner charge is in the ledger; a Feratel test registration works'],
  ['M4', '20 Dec', 'Apartments tab works, Archipex trial import done, production infrastructure ready'],
  ['M5', '5 Jan', 'Dress rehearsal (bookings) passed, security self-check signed off, sign-off from Picobello'],
  ['M6', '10 Jan', 'Phase 1a live: bookings work in production'],
  ['M7', '15 Apr', 'Phase 1b ready: guest journey incl. badges, tested on the existing holiday apartments'],
];

// Needed-by dates from the file. The file gives no delivery status, so the
// colour shows urgency by date only.
const deps: [string, string, number][] = [
  ['dataCycle test access + API docs', '10 Nov', 1],
  ['Domain / DNS access (picobello.ch)', '15 Nov', 1],
  ['Lodgify API key + test property', '16 Nov', 1],
  ['Real fee values and texts for emails', '30 Nov', 2],
  ['AI provider account / decision', '30 Nov', 2],
  ['Feratel API access (Picobello sets it up)', '30 Nov', 2],
  ['Archipex data access (we export ourselves)', '1 Dec', 2],
  ['Listing content (photos, texts) to migrate', '14 Dec', 3],
  ['Image usage rights (both tourism offices)', '14 Dec', 3],
  ['Production keys for all systems', '28 Dec', 3],
  ['Staff available for training', '6-8 Jan', 3],
  ['Stripe restricted key (test + live)', '15 Jan', 3],
  ['SALTO / Immer AG API access + test site', '1 Mar', 3],
];
const regional: [string, string][] = [
  ['6-10 Nov', 'dataCycle test access, API study, list of categories (vision step 1)'],
  ['16-29 Nov', 'RegionalContentPort, fake adapter with the vision\'s sample data, regional.sync, regional_items cache'],
  ['30 Nov-13 Dec', 'Weather port, signals, candidate filter, AI ranking + fallback, "Today" feed in the Guest App (flag off)'],
  ['14 Dec-5 Jan', 'Test at the Lenk in Picobello\'s apartments (vision step 2): rain, Gulf family, fresh snow; insights events'],
  ['10 Jan', 'Phase 1a live; the feed is still behind the flag'],
  ['15-31 Jan', 'Regional go-live for all guests (vision step 3), then evaluation and Saanenland'],
];

const weeks: { w: string; d: string; m?: string; groups: [string, string[]][] }[] = [
  { w: 'Week 0', d: '5 Nov (Thu) · architecture review', m: 'M0', groups: [
    ['Review meeting with Picobello', ['Walk through the architecture (this web page, screen share)', 'Decide the database host (Cloud SQL vs Supabase); until then plan and develop locally', 'Confirm the go-live list']],
    ['After the meeting', ['Build each answer into the architecture and remove it from the open questions', 'Send the final PDF to Picobello', 'Request access from Picobello: Lodgify, Stripe, Feratel/LST, SALTO/Immer AG, domain/DNS, Archipex data access, dataCycle test access (by 10 Nov), image rights']],
  ] },
  { w: 'Week 1', d: '6-15 Nov · foundation', m: 'M1', groups: [
    ['Repository and tooling', ['Monorepo (pnpm + Turborepo), apps/ and packages/', 'TypeScript strict, ESLint, Prettier, dependency-cruiser', 'Commit conventions, PR template, CODEOWNERS', 'Security tools in CI: gitleaks, npm audit / OSV, Semgrep, Renovate']],
    ['CI/CD and environments', ['GitHub Actions on every PR', 'Terraform: GCP staging project, Cloudflare Pages projects', 'Workload Identity Federation; auto-deploy main → staging; preview URLs']],
    ['Database, backend, auth', ['Drizzle + first migrations; seed: 2 houses, 22 units, demo owners', 'Hono API with OpenAPI, errors, pipeline, logging, Sentry; worker with pg-boss', 'Better Auth: staff login + 2FA, owner magic link; guest stay-token design']],
    ['Design system and Back Office basics', ['Tokens, self-hosted fonts, base components, app shells', 'Houses, units, owners, ownerships, settings, audit log screens']],
  ] },
  { w: 'Weeks 2-3', d: '16-29 Nov · Lodgify + Owner Portal', m: 'M2', groups: [
    ['Integrations backbone', ['inbox_events, outbox, integration_status', 'Integrations page; port + fake adapter pattern; recorded payloads']],
    ['Lodgify read + stays', ['Map 22 units; webhook + re-fetch; booking → stay mapping; nightly reconciliation', 'Ledger: booking_amounts; stays list, detail, calendar; exclusion constraint']],
    ['Rule engine + Owner Portal', ['Checks C1-C8, quota, costs; 100 % unit tests with contract examples', 'Magic link, overview, quota bars, calendar, reserve flow, my reservations, balance']],
    ['Lodgify write + ledger', ['Own-use block and friends booking within 5 minutes; failure → retry + alert', 'accounts, transactions, entries; append-only triggers; owner_charge transactions']],
  ] },
  { w: 'Weeks 4-5', d: '30 Nov-13 Dec · ledger, Feratel, Back Office', m: 'M3', groups: [
    ['Ledger complete for bookings', ['booking_amounts for every channel booking; owner charges (cleaning, laundry, friends, cancellation fee)', 'Nightly balance check; reconciliation list']],
    ['Feratel adapter', ['Picobello sets up the API; registration, update, cancel; category codes', 'Test registration; manual fallback "registered in Deskline"']],
    ['Emails + Back Office', ['Owner magic links, confirmations, reminders (Postmark, DE/EN)', 'Today view, stays list + detail, calendar; channel cancellations free the nights']],
  ] },
  { w: 'Week 6', d: '14-20 Dec · Apartments, Archipex, production', m: 'M4', groups: [
    ['Apartments tab', ['Listing editor, photo pipeline, sync rules + per-field states', 'Push to Lodgify or copy + confirm; "What\'s missing"']],
    ['Archipex + production infrastructure', ['Import screen, validation report, trial import on staging', 'Terraform prod, database HA, load balancer, domains, certificates, alerts, backups']],
    ['Security', ['First OWASP ZAP scan of staging', 'Self-check items for M2-M4 ticked']],
  ] },
  { w: 'Weeks 7-8', d: '21 Dec-5 Jan · hardening + dress rehearsal (also the buffer)', m: 'M5', groups: [
    ['Quality', ['Playwright E2E for the Phase 1a flows (channel booking → ledger, owner and friends reservations, cancellation, listing edit); permission-matrix tests', 'Accessibility, performance (API p95)', 'Security self-check: walk through the Phase 1a items, fix; ZAP, headers and TLS on production']],
    ['Polish and data', ['All empty / loading / error states; copy review DE/FR/EN by a native speaker', 'Final settings confirmed; units mapped to Lodgify in production; Archipex final import on 31.12']],
    ['Go-live preparation + dress rehearsal', ['Production keys, webhooks, backups + restore test, alerts, runbooks', 'Real booking via Lodgify → stay → Feratel → ledger; channel cancellation frees the nights; owner reservation → block; friends booking; change / cancel with fee']],
  ] },
  { w: 'Week 9', d: '6-10 Jan · delivery', m: 'M6', groups: [
    ['Training and go-live', ['Back Office walkthrough (recorded), short user guides DE/EN', 'Send owner portal invitations, monitor bookings and integrations closely']],
    ['Delivery package (10 Jan)', ['Live URLs: guest / owner / admin / api', 'Architecture docs v2 (as built), ADRs, runbooks', 'Access handed to Picobello / Bernis: GitHub, GCP, Cloudflare, Stripe webhooks, Postmark, Sentry', 'Known limitations + Phase 2 plan']],
  ] },
  { w: 'Phase 1b', d: '11 Jan-15 Apr · guest journey (first guests ~May)', m: 'M7', groups: [
    ['Guest App (11 Jan-14 Feb)', ['PWA, personal link, locked page after departure; home, arrival info, DE/FR/EN', 'Invitations 3 days before arrival; online check-in; guest cards from Feratel']],
    ['Payments in the app (15 Feb-7 Mar)', ['Stripe: friends pay, extra persons, refunds; all into the ledger', 'Extensions (same apartment, else the one empty the longest), guest edits, date changes, late check-in / check-out']],
    ['SALTO badges (8-28 Mar)', ['Access 16:00 → 10:00, doors per unit, extend / move / revoke; access screen', 'Dispenser process agreed with Picobello (guests enter a code)']],
    ['Test on the existing holiday apartments (29 Mar-15 Apr)', ['Real bookings, full journey: invite → check-in → payment → guest card → badge → extension → ledger', 'Security self-check Phase 1b items ticked']],
  ] },
];

const dod = [
  'Code reviewed and merged, all checks green',
  'Unit / integration tests written (rules and money: 100 %)',
  'Works in DE / FR / EN where user-facing',
  'Deployed to staging and tested there',
  'Audit log and error handling in place',
  'Matches the design system, incl. loading, empty, error states and mobile layout',
];
const golive: { t: string; d: string; tone: string; items: string[] }[] = [
  { t: 'January', d: '~10 Jan 2027 · everything for bookings', tone: 'now', items: [
    'Bookings from Airbnb, Booking, website etc. via Lodgify; cancellations free the dates',
    'Owner Portal: login, calendar, quota, own-use and friends reservations with the contract rules, change / cancel with fee, account balance',
    'Back Office: Today, stays, calendar, owners, settings, users, integrations, audit log',
    'Apartments tab: listing content per channel, sync to Lodgify',
    'Feratel connection (Picobello\'s API)',
    'Ledger: every booking and owner charge from the first live booking',
    'Archipex import at cutoff 31.12; owner emails; security self-check',
  ] },
  { t: 'Before the first guests', d: 'ready by 15 Apr · guests from ~May', tone: 'next', items: [
    'Guest App: invitation link, arrival info, online check-in, guest cards',
    'Payments in the app: friends pay, extra persons, extensions, date changes, refunds (into the ledger)',
    'Extensions with room choice, guest detail edits, late check-in / check-out',
    'SALTO badges and the dispenser process',
    '"Today" regional feed for guests',
    'Full test on existing holiday apartments with real bookings',
  ] },
  { t: 'Later', d: 'Phase 2 · from April 2027', tone: 'later', items: [
    'Accounting settlement: owner statements, payouts, bank import, Bexio, VAT, tourist-tax reconciliation, ZWG report',
    'WhatsApp, cleaning (PicobelloAI), repairs + DocuSign',
    'Partner offers (ski pass, half board), reviews',
    'MCP server and "Ask me" chat (architecture ready now)',
  ] },
];
const urg = ['', 'urgent', 'soon', 'later'];
const urgLabel = ['', 'by mid-Nov', 'by early Dec', 'mid-Dec or later'];
---
<Takeaway>Bookings go live on Sunday 10 January 2027, built in seven blocks that each end in a milestone Picobello can see working. The guest journey follows by 15 April, tested on real bookings before the first guests arrive around May.</Takeaway>

<div class="block">
  <h3 class="block-title">Gantt · 6 Nov to 10 Jan, then Phase 1b</h3>
  <Figure label="Gantt chart of the seven work blocks from 5 Nov 2026 to the bookings go-live on 10 Jan 2027, then Phase 1b to 15 Apr" minWidth={960}>
    <Gantt label="Phase 1 timeline" />
  </Figure>
</div>

<div class="block">
  <h3 class="block-title">Regional content track (dataCycle) · in parallel</h3>
  <p class="block-sub">From the dataCycle vision. Milestones: R1 10 Nov test access · R2 13 Dec feed works in staging with real data · R3 31 Jan regional content ready; guests see it from their arrival (~May). Agents / MCP: tool-registry discipline now, built after go-live.</p>
  <div class="table-wrap">
    <table class="data">
      <thead><tr><th>Weeks</th><th>Work</th></tr></thead>
      <tbody>{regional.map(([w, t]) => <tr><td class="tnum nowrap">{w}</td><td>{t}</td></tr>)}</tbody>
    </table>
  </div>
</div>

<div class="block">
  <h3 class="block-title">What goes live when <Pill kind="verify" text="To confirm" /></h3>
  <div class="golive">
    {golive.map((g) => (
      <section class={`gl gl-${g.tone}`}>
        <header><b>{g.t}</b><span>{g.d}</span></header>
        <ul class="list compact">{g.items.map((i) => <li>{i}</li>)}</ul>
      </section>
    ))}
  </div>
</div>

<div class="block">
  <h3 class="block-title">What Picobello can see at each milestone</h3>
  <ol class="ms">
    {milestones.map(([m, d, t], i) => (
      <li class={i === milestones.length - 1 ? 'last' : ''}>
        <span class="ms-dot" aria-hidden="true"></span>
        <div class="ms-h"><span class="mono">{m}</span><b class="tnum">{d}</b></div>
        <p>{t}</p>
      </li>
    ))}
  </ol>
</div>

<div class="block">
  <div class="grid grid-2 tl-split">
    <div>
      <h3 class="block-title">Dependencies on Picobello</h3>
      <div class="table-wrap">
        <table class="data deps">
          <thead><tr><th>Item</th><th>Needed by</th><th>Urgency</th></tr></thead>
          <tbody>{deps.map(([a, b, u]) => <tr><td>{a}</td><td class="tnum nowrap">{b}</td><td><span class={`light l-${urg[u]}`}>{urgLabel[u]}</span></td></tr>)}</tbody>
        </table>
      </div>
      <p class="note">Colour shows urgency by the date needed. The file does not record delivery status yet; track it after 5 Nov.</p>
    </div>
    <div>
      <h3 class="block-title">Definition of done · every task</h3>
      <ul class="dod">{dod.map((d) => <li><Icon name="check" size={16} />{d}</li>)}</ul>
      <h3 class="block-title after">After go-live · 11 Jan onwards</h3>
      <ul class="list">
        <li><b>Hypercare, 2 weeks:</b> daily check of integrations, failed jobs and ledger balance; fast fixes.</li>
        <li><b>Phase 1b</b> (11 Jan to 15 Apr): the guest journey, tested on existing holiday apartments before the first guests (~May).</li>
        <li><b>Phase 2</b> (from April 2027): accounting settlement (statements, bank, Bexio, VAT, tourist-tax reconciliation, ZWG report), WhatsApp, cleaning (PicobelloAI), repairs + DocuSign, partner offers (ski pass, half board).</li>
      </ul>
    </div>
  </div>
</div>

<div class="block">
  <h3 class="block-title">Week by week</h3>
  {weeks.map((w) => (
    <details class="disclose wk">
      <summary><span class="wk-w">{w.w}</span><span class="count">{w.d}</span>{w.m && <span class="wk-m mono">→ {w.m}</span>}<Icon name="chevron-right" size={18} class="chev" /></summary>
      <div class="disclose-body">
        <div class="wk-groups">
          {w.groups.map(([g, items]) => (
            <div><h5>{g}</h5><ul class="list compact">{items.map((it) => <li>{it}</li>)}</ul></div>
          ))}
        </div>
      </div>
    </details>
  ))}
</div>

<style>
  .golive { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: var(--s-4); align-items: start; }
  @media (max-width: 1100px) { .golive { grid-template-columns: minmax(0, 1fr); } }
  .gl { background: var(--surface); border: 1px solid var(--line); border-top: 4px solid var(--primary-600); border-radius: var(--r-card); box-shadow: var(--e-1); padding: var(--s-4) var(--s-5); }
  .gl-next { border-top-color: var(--accent-500); }
  .gl-later { border-top-color: var(--line-strong); }
  .gl header { display: grid; gap: 2px; margin-bottom: var(--s-3); }
  .gl header b { font-family: var(--font-head); font-size: 1.125rem; font-weight: 700; }
  .gl header span { font-size: 14px; color: var(--ink-muted); }
  .block-title :global(.pill) { font-size: 13px; margin-left: 8px; vertical-align: 0.2em; }
  .ms { list-style: none; margin: 0; padding: 0; display: grid; grid-template-columns: repeat(8, minmax(0, 1fr)); gap: 0; position: relative; }
  .ms::before { content: ""; position: absolute; left: 8px; right: 8px; top: 8px; border-top: 2px solid var(--primary-100); }
  .ms li { position: relative; padding: 28px 14px 0 0; display: grid; gap: 6px; align-content: start; }
  .ms-dot { position: absolute; top: 0; left: 0; width: 18px; height: 18px; transform: rotate(45deg) scale(.8); background: var(--surface); border: 2px solid var(--primary-700); border-radius: 3px; }
  .ms li.last .ms-dot { background: var(--accent-500); border-color: var(--surface); box-shadow: 0 0 0 1px var(--accent-500); }
  .ms-h { display: flex; align-items: baseline; gap: 8px; }
  .ms-h .mono { font-size: 13px; font-weight: 700; color: var(--primary-700); }
  .ms li.last .ms-h .mono { color: var(--accent-700); }
  .ms-h b { font-size: 16px; font-weight: 600; }
  .ms p { font-size: 14.5px; color: var(--ink-muted); line-height: 1.45; }
  @media (max-width: 1279px) { .ms { grid-template-columns: 1fr; gap: 14px; } .ms::before { left: 8px; right: auto; top: 8px; bottom: 8px; border-top: 0; border-left: 2px solid var(--primary-100); } .ms li { padding: 0 0 0 34px; } }

  .tl-split { gap: var(--s-8); align-items: start; }
  @media (max-width: 1279px) { .tl-split { grid-template-columns: minmax(0, 1fr); } }
  td.nowrap { white-space: nowrap; }
  .light { display: inline-flex; align-items: center; gap: 6px; font-size: 13px; font-weight: 500; white-space: nowrap; }
  .light::before { content: ""; width: 9px; height: 9px; border-radius: 50%; }
  .l-urgent { color: var(--danger-text); } .l-urgent::before { background: var(--danger-vivid); }
  .l-soon { color: var(--warning-text); } .l-soon::before { background: var(--warning-vivid); }
  .l-later { color: var(--success-text); } .l-later::before { background: var(--success-vivid); }
  .note { margin-top: var(--s-3); font-size: 14px; color: var(--ink-muted); line-height: 1.5; }
  .dod { list-style: none; margin: 0; padding: 0; display: grid; gap: 8px; }
  .dod li { display: grid; grid-template-columns: 24px 1fr; gap: 8px; font-size: 15.5px; line-height: 1.45; }
  .dod :global(svg) { color: var(--success-vivid); margin-top: 3px; }
  .after { margin-top: var(--s-8); }
  .wk-w { min-width: 92px; }
  .wk-m { margin-left: 4px; font-size: 13px; font-weight: 700; color: var(--primary-700); }
  .wk-groups { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: var(--s-5) var(--s-8); }
  @media (max-width: 767px) { .wk-groups { grid-template-columns: 1fr; } }
  .wk-groups h5 { margin: 0 0 8px; font-family: var(--font-head); font-size: 15.5px; font-weight: 700; }
</style>
