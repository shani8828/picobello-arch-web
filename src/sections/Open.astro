---
// Appendix: decisions from the review (file 12 part F), inputs still to
// deliver (file 15) and every [Verify] item.
import Pill from '../components/Pill.astro';

const decided: [string, string, string][] = [
  ['Database', 'Supabase (Zurich), plain Postgres only', '#d8'],
  ['Rounding', 'to 5 Rappen at charge level, as a setting', '#logic'],
  ['Co-owned units', 'costs split by share, last Rappen by largest remainder', '#money'],
  ['High-season weeks', 'max 3 weeks, counted per high-season period', '#logic'],
  ['Owner check-in', 'in the Owner Portal from Phase 1a', '#scope'],
  ['"Friends pay" in Phase 1a', 'charged to the owner account until in-app payment (Phase 1b)', '#scope'],
  ['Settings date', 'fees and cancellation by booking date; high season and tourist tax by stay date', '#logic'],
  ['Owner / friends cancellation', '< 90 days before arrival: CHF 50; paid costs go back to the payer minus CHF 50', '#logic'],
  ['Shortened stays', 'on site: no refund; in advance: handled by the booking platform (Airbnb, Booking.com, Lodgify for website bookings)', '#logic'],
  ['ID numbers', 'kept 2 years from arrival, then deleted', '#database'],
  ['Night help', 'emergency key box; the code is shown in the app to checked-in guests during their stay', '#integrations'],
  ['Domains', 'admin. / owner. / guest. / api.picobello.ch', '#infrastructure'],
  ['Weather and AI', 'MeteoSwiss open data; Anthropic Claude (Haiku)', '#regional'],
  ['Insights export', 'monthly CSV per tourism office', '#regional'],
  ['MCP and "Ask me" chat', 'after go-live, for staff first', '#regional'],
  ['Outside security review', 'not in Phase 1; possible with the Phase 2 budget', '#selfcheck'],
];

const inputs: [string, string, string][] = [
  ['Tourist-tax mode for every owner (yearly flat or per stay)', '9 Nov', '#database'],
  ['Worked contract examples for the own-use rules', '20 Nov', '#logic'],
  ['Image usage rights in writing from both tourism offices', '14 Dec', '#regional'],
  ['Emergency phone number and the key-box code per house', '1 Mar', '#integrations'],
];

const verify: { file: string; href: string; items: string[] }[] = [
  { file: 'Integrations · Lodgify', href: '#integrations', items: [
    'Webhook subscribe path and payload (docs.lodgify.com)',
    'Webhook event names (from a third-party connector list)',
    'Whether Lodgify signs webhooks; if yes, also check the signature',
    'Date change on a booking vs an additional linked booking for extra nights; design supports both via stay_segments',
    'Which listing fields the API can write; the sync matrix stores the answer per field',
    'Exact field names in the booking mapping',
    'Rate limits',
  ] },
  { file: 'Integrations · Stripe', href: '#integrations', items: ['TWINT activation on the account', 'Current card-authorisation expiry (about 7 days) for deposits'] },
  { file: 'Integrations · Feratel', href: '#integrations', items: ['Everything in the Feratel section, with Feratel / LST: interface, credentials, category codes, test environment'] },
  { file: 'Integrations · SALTO', href: '#integrations', items: ['Endpoints for users, access groups and time schedules (Connect API reference)'] },
  { file: 'Infrastructure', href: '#infrastructure', items: ['Monthly cost estimate, with the GCP pricing calculator'] },
  { file: 'Regional content, AI, agents', href: '#regional', items: [
    'dataCycle API: auth method, endpoints, format, rate limits',
    'dataCycle change webhooks; whether live railway status is in dataCycle',
    'AI provider: region, retention, no training on our data',
    'MCP remote-server auth (OAuth) in the current spec',
  ] },
  { file: 'Comparisons', href: '#d8', items: ['Supabase Zurich region', 'Neon data location (EU, not CH)', 'Supabase backup location (Zurich)', 'Supabase session pooler / IPv4 add-on for the pg-boss connection'] },
  { file: 'Integrations · SALTO dispenser', href: '#integrations', items: ['Exact dispenser process with Immer AG'] },
];
const verifyCount = verify.reduce((n, g) => n + g.items.length, 0);
---
<div class="block">
  <div class="counts">
    <div><span class="v tnum">0</span><span class="l">questions still open</span></div>
    <div><span class="v tnum">{inputs.length}</span><span class="l">inputs still to deliver</span></div>
    <div><span class="v tnum">{verifyCount}</span><span class="l">items to verify with vendors</span></div>
  </div>
</div>

<div class="block">
  <h3 class="block-title">Decided in the review</h3>
  <div class="table-wrap">
    <table class="data">
      <thead><tr><th>Topic</th><th>Decision</th></tr></thead>
      <tbody>{decided.map(([t, d, href]) => <tr><td><a href={href}>{t}</a></td><td>{d}</td></tr>)}</tbody>
    </table>
  </div>
</div>

<div class="block">
  <h3 class="block-title">Inputs still to deliver</h3>
  <p class="block-sub">Data from Picobello and the tourism offices, not decisions. Each is needed by the date shown.</p>
  <ul class="items">{inputs.map(([t, d, href]) => <li><p>{t} · <b class="tnum">{d}</b></p><a href={href} class="src">details</a></li>)}</ul>
</div>

<div class="block">
  <h3 class="block-title">To verify once we have access <Pill kind="verify" /></h3>
  <p class="block-sub">Taken from third-party descriptions or assumptions; to check in the vendor's own docs.</p>
  <div class="vgroups">
    {verify.map((g) => (
      <section class="vg">
        <a href={g.href} class="vg-h">{g.file}</a>
        <ul>{g.items.map((it) => <li>{it}</li>)}</ul>
      </section>
    ))}
  </div>
</div>

<style>
  .counts { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); border: 1px solid var(--line); border-radius: var(--r-card); background: var(--surface); box-shadow: var(--e-1); }
  .counts div { display: grid; gap: 4px; padding: var(--s-5) var(--s-6); border-left: 1px solid var(--line); }
  .counts div:first-child { border-left: 0; background: var(--accent-50); border-radius: var(--r-card) 0 0 var(--r-card); }
  .counts .v { font-size: 2.25rem; font-weight: 600; line-height: 1; letter-spacing: -0.02em; }
  .counts .l { font-size: var(--fs-ui); color: var(--ink-muted); }
  @media (max-width: 640px) { .counts { grid-template-columns: 1fr; } .counts div { border-left: 0; border-top: 1px solid var(--line); } .counts div:first-child { border-top: 0; border-radius: var(--r-card) var(--r-card) 0 0; } }

  .qs { list-style: none; margin: 0; padding: 0; border-top: 1px solid var(--line); }
  .qs li { display: grid; grid-template-columns: 40px 1fr 140px; gap: var(--s-4); align-items: start; padding: 14px 0; border-bottom: 1px solid var(--line); }
  .qs .i { display: grid; place-items: center; width: 30px; height: 30px; border-radius: 8px; background: var(--warning-soft); color: var(--warning-text); font-weight: 700; font-size: 14px; }
  .qs p { font-size: var(--fs-body-sm); font-weight: 500; line-height: 1.45; }
  .src { display: inline-block; margin-top: 4px; font-size: 13.5px; color: var(--ink-muted); text-decoration: none; }
  .src:hover { color: var(--primary-700); text-decoration: underline; }
  .ans { height: 30px; border-bottom: 1.5px dashed var(--line-strong); }
  @media (max-width: 767px) { .qs li { grid-template-columns: 40px 1fr; } .ans { display: none; } }
  .note { margin-top: var(--s-4); font-size: 14.5px; color: var(--ink-muted); line-height: 1.55; max-width: var(--measure); }
  .block-title :global(.pill) { font-size: 13px; margin-left: 8px; vertical-align: 0.2em; }

  .items { list-style: none; margin: 0; padding: 0; display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: var(--s-3); }
  @media (max-width: 767px) { .items { grid-template-columns: 1fr; } }
  .items li { padding: 14px 16px; background: var(--surface); border: 1px solid var(--line); border-left: 3px solid var(--warning-vivid); border-radius: var(--r-control); }
  .items p { font-size: 15.5px; line-height: 1.45; }
  .prop { margin-top: 2px; font-size: 14px !important; font-weight: 600 !important; color: var(--primary-700); }

  .vgroups { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: var(--s-3); align-items: start; }
  @media (max-width: 767px) { .vgroups { grid-template-columns: 1fr; } }
  .vg { padding: 14px 16px; background: var(--surface); border: 1px solid var(--line); border-left: 3px solid var(--info-vivid); border-radius: var(--r-control); }
  .vg-h { display: block; font-weight: 600; font-size: 15px; color: var(--ink); text-decoration: none; margin-bottom: 6px; }
  .vg-h:hover { color: var(--primary-700); }
  .vg ul { margin: 0; padding-left: 18px; display: grid; gap: 4px; }
  .vg li { font-size: 14.5px; color: var(--ink-muted); line-height: 1.45; }
</style>
