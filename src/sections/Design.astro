---
// 13 Design system "Alpine Fresh". Source: arch/13-design-system.txt
import Takeaway from '../components/Takeaway.astro';
import Icon from '../components/Icon.astro';

const palettes: { name: string; note: string; sw: [string, string, string, boolean?][] }[] = [
  { name: 'Primary · Alpine Blue', note: 'Actions, links, focus, selection, progress', sw: [
    ['primary-900', '#0B2E6B', 'headings on blue, logo text', true], ['primary-800', '#0F48A8', 'pressed, active nav', true], ['primary-700', '#1457C7', 'button hover', true],
    ['primary-600', '#1A66E0', 'PRIMARY BUTTONS, links, focus', true], ['primary-500', '#2F80FF', 'icons, chart lines', true], ['primary-100', '#DCEBFF', 'selected rows, focus ring'], ['primary-50', '#F0F6FF', 'hover, info panels'] ] },
  { name: 'Accent · Alpenglow', note: 'Brand moments, welcome / success, one highlight per screen', sw: [
    ['accent-500', '#FF6B3D', 'logo mark, welcome, "your stay"'], ['accent-700', '#B83A12', 'accent text', true], ['accent-50', '#FFF3EE', 'welcome banner'] ] },
  { name: 'Supporting vivids', note: 'Data, calendars, illustration; never status', sw: [
    ['sun-500', '#FFB020', 'high season, quota bars'], ['sun-50', '#FFF7E6', 'high-season band'], ['glacier-500', '#00B8D9', 'charts, accents'],
    ['violet-600', '#6D4AE0', 'own-use stays', true], ['violet-300', '#B9A6F7', 'friends stays'], ['violet-50', '#F3F0FF', 'own-use areas'] ] },
  { name: 'Neutrals · Snow & Stone', note: 'About 90 % of every screen', sw: [
    ['ink', '#0E1A2B', 'main text, headings', true], ['ink-muted', '#475467', 'secondary text, labels', true], ['ink-faint', '#98A2B3', 'placeholders, disabled'], ['line', '#E4E9F0', 'borders, dividers'],
    ['line-strong', '#CBD3DE', 'table header border'], ['surface', '#FFFFFF', 'cards, inputs'], ['surface-2', '#F3F6FA', 'panels, sidebar'], ['snow', '#F7F9FC', 'page background'] ] },
];
const semantic: [string, string, string, string, string][] = [
  ['success', '#0B7A3B', '#E8F8EE', '#12A150', 'paid, checked in, in sync, ready'],
  ['warning', '#8A5300', '#FFF6E0', '#F5A000', 'payment pending, manual needed'],
  ['danger', '#C0291E', '#FEECEA', '#F0443A', 'failed, rejected, cancelled'],
  ['info', '#0B6F85', '#E3F7FB', '#00B8D9', 'syncing, pending, hints'],
];
const dark: [string, string, boolean?][] = [
  ['bg', '#0B1220', true], ['surface', '#131C2E', true], ['surface-2', '#1A2540', true], ['line', '#26334D', true], ['ink', '#E9EEF5'], ['ink-muted', '#9AA8BC'],
  ['primary', '#5B9BFF'], ['accent', '#FF8A63'], ['success', '#3DD68C'], ['warning', '#FFC247'], ['danger', '#FF6B5E'], ['info', '#33D1EB'],
];

type Spec = [string, string, number, number, number, string];
const specs: { app: string; base: string; rows: Spec[] }[] = [
  { app: 'Presentation · this page', base: 'body never below 18 px', rows: [
    ['Title', 'head', 56, 60, 800, 'Picobello Platform'], ['Section', 'head', 32, 38, 700, 'System context'],
    ['Body', 'body', 22, 32, 400, 'One master per piece of data.'], ['Diagram label', 'body', 16, 22, 500, 'payment sessions, refunds'] ] },
  { app: 'Guest App', base: 'base 16 px, phone first', rows: [
    ['display', 'head', 32, 38, 800, "You're all set!"], ['h1', 'head', 24, 30, 700, 'Check-in'], ['h2', 'head', 20, 26, 700, 'Your companions'],
    ['h3', 'body', 18, 24, 600, 'Badge access'], ['body', 'body', 16, 24, 400, 'Check-in from 16:00.'], ['label', 'body', 14, 20, 500, 'Date of birth'],
    ['caption', 'body', 13, 18, 400, 'Updated 2 min ago'], ['amount-lg', 'num', 32, 38, 600, "CHF 390.00"] ] },
  { app: 'Owner Portal', base: 'base 16 px mobile, 15 px desktop', rows: [
    ['h1', 'head', 28, 34, 700, 'My calendar'], ['h2', 'head', 20, 26, 700, 'Own use this year'], ['h3', 'body', 17, 24, 600, 'Next stays'],
    ['body', 'body', 16, 24, 400, 'Friends stays count to quota.'], ['quota', 'num', 28, 34, 600, '34 / 120'], ['caption', 'body', 13, 18, 400, 'Never below 13 px'] ] },
  { app: 'Back Office', base: 'base 14 px, dense', rows: [
    ['h1', 'head', 24, 30, 700, 'Today'], ['h2', 'head', 18, 24, 700, 'Arrivals'], ['kpi', 'num', 30, 36, 600, '12'],
    ['body', 'body', 14, 20, 400, 'Stay detail with timeline'], ['table', 'num', 13, 18, 400, '3078-4 · 10.01.2027'], ['badge', 'body', 12, 16, 500, 'No text below 12 px'] ] },
];

const avoid: [string, string][] = [
  ['Purple-blue gradients, glowing blobs, glassmorphism', 'Flat, confident colour; at most one subtle gradient (photo overlay)'],
  ['Hero section + 3 identical feature cards with emoji / icons in circles', 'Real content first: the guest sees their stay, dates and next step'],
  ['Emojis as icons', 'One icon family (Lucide), same stroke and size everywhere'],
  ['Everything rounded-2xl with big shadows', 'One radius family (6 / 10 / 14 / 20) and borders before shadows'],
  ['Grey text on grey, faded colours', 'Strong ink text; soft tints only for backgrounds; vivid for emphasis'],
  ['Centred everything', 'Left-aligned text, clear grid, aligned edges and baselines'],
  ['Lorem ipsum / "Welcome to our platform"', 'Real copy: "Your badge is ready. Collect it at the machine next to the entrance."'],
  ['Stock illustrations, 3D blobs', 'Real apartment photos and Lenk scenery; minimal line drawings'],
  ['Same spacing everywhere', 'Deliberate rhythm: tight inside groups, generous between groups'],
  ['Spinners for everything', 'Skeletons shaped like the real layout; optimistic updates'],
  ['Random colours for categories', 'Every colour has a defined meaning'],
  ['Decorative motion', 'Motion only for feedback, 150-200 ms'],
];

const contrast: [string, string, string][] = [
  ['ink on white', '17.5:1', 'AAA'], ['ink-muted on white', '7.7:1', 'AAA'], ['ink-muted on snow', '7.3:1', 'AAA'],
  ['white on primary-600 (button)', '5.2:1', 'AA'], ['white on primary-700 (hover)', '6.5:1', 'AA'], ['white on primary-800 (pressed)', '8.4:1', 'AAA'],
  ['primary-600 link on white', '5.2:1', 'AA'], ['primary-600 on primary-50', '4.8:1', 'AA'], ['accent-700 on white', '5.8:1', 'AA'], ['accent-700 on accent-50', '5.3:1', 'AA'],
  ['ink on accent-500', '6.2:1', 'AA'], ['ink on sun-500', '9.6:1', 'AAA'], ['ink on glacier-500', '7.4:1', 'AAA'], ['violet-600 on white', '5.7:1', 'AA'],
  ['success / warning / danger / info text on soft', '4.9 / 5.9 / 5.1 / 5.2', 'AA'],
  ['dark: ink on #0B1220', '16.1:1', 'AAA'], ['dark: muted on #131C2E', '7.1:1', 'AAA'], ['dark: #0B1220 on primary #5B9BFF', '6.8:1', 'AA'], ['dark: accent on #131C2E', '7.4:1', 'AAA'],
  ['primary-500 on white', '3.7:1', 'icons / large only'], ['accent-500 on white', '2.8:1', 'decoration only'], ['success / danger vivid on white', '3.4-3.8', 'dots and icons only'],
];
const fam = (f: string) => (f === 'head' ? 'var(--font-head)' : 'var(--font-body)');
---
<Takeaway>Soft base, vivid emphasis: about 60 % snow and white, 30 % ink and neutrals, 10 % vivid colour. Because vivid colour is rare, it pops, and every colour has one job.</Takeaway>

<div class="block">
  <div class="direction">
    <div>
      <span class="eyebrow">Theme</span>
      <p class="dir-name">Alpine Fresh</p>
      <p class="dir-text">Inspired by Lenk in the Simmental: a vivid alpine-sky blue for trust and action, snow-white and cool stone neutrals for calm, and a bright alpenglow coral (the pink-orange light on mountains at sunset) as the signature accent.</p>
    </div>
    <div class="ratio" aria-label="60 percent snow and white, 30 percent ink and neutrals, 10 percent vivid">
      <div class="bar"><span class="r60">60 %</span><span class="r30">30 %</span><span class="r10">10</span></div>
      <div class="ratio-l"><span>snow / white</span><span>ink + neutrals</span><span>vivid</span></div>
    </div>
  </div>
  <ol class="principles">
    <li><b>P1 Clarity first</b> one main action per screen, plain language</li>
    <li><b>P2 Status always visible</b> colour + icon + word, never colour alone</li>
    <li><b>P3 Colour has a job</b> blue = action, semantic = status, alpenglow = brand, sun / glacier / violet = data</li>
    <li><b>P4 Touch and keyboard</b> touch-friendly on mobile, keyboard-friendly on desktop</li>
    <li><b>P5 Accessible</b> WCAG 2.1 AA for all text, calculated</li>
    <li><b>P6 Crafted, not generated</b> see "Avoid vs do" below</li>
  </ol>
</div>

<div class="block">
  <h3 class="block-title">Colour palette</h3>
  {palettes.map((p) => (
    <div class="pal">
      <div class="pal-h"><b>{p.name}</b><span>{p.note}</span></div>
      <div class="swatches">
        {p.sw.map(([t, hex, use, darkText]) => (
          <div class="sw">
            <div class={`chip-c${darkText ? ' on-dark' : ''}${hex === '#FFFFFF' ? ' white' : ''}`} style={`background:${hex}`}><span class="mono">{hex}</span></div>
            <span class="sw-t mono">{t}</span>
            <span class="sw-u">{use}</span>
          </div>
        ))}
      </div>
    </div>
  ))}
  <div class="pal">
    <div class="pal-h"><b>Semantic · status</b><span>Soft background + text colour for the label, vivid for the dot or icon</span></div>
    <div class="sem">
      {semantic.map(([n, text, soft, vivid, use]) => (
        <div class="sem-row">
          <span class="sem-n mono">{n}</span>
          <span class="sem-c" style={`background:${text}`}><span class="mono">{text}</span><em>text</em></span>
          <span class="sem-c light" style={`background:${soft}`}><span class="mono">{soft}</span><em>soft</em></span>
          <span class="sem-c" style={`background:${vivid}`}><span class="mono">{vivid}</span><em>vivid</em></span>
          <span class="sem-pill" style={`background:${soft};color:${text}`}><i style={`background:${vivid}`}></i>{use.split(',')[0]}</span>
          <span class="sem-u">{use}</span>
        </div>
      ))}
    </div>
  </div>
  <div class="pal">
    <div class="pal-h"><b>Dark mode</b><span>Guest App and Owner Portal follow the phone; Back Office light only in Phase 1 (tokens ready)</span></div>
    <div class="dark-row">
      {dark.map(([t, hex, isBg]) => <div class="dk"><span class="dk-c" style={`background:${hex}`}></span><span class="mono dk-t">{t}</span><span class="mono dk-h">{hex}</span></div>)}
    </div>
  </div>
  <details class="disclose">
    <summary>Contrast check · WCAG 2.1, calculated<span class="count">{contrast.length} pairs</span><Icon name="chevron-right" size={18} class="chev" /></summary>
    <div class="disclose-body">
      <table class="ctab"><tbody>{contrast.map(([a, r, res]) => <tr><td>{a}</td><td class="tnum">{r}</td><td><span class={`res ${res.startsWith('AAA') ? 'aaa' : res === 'AA' ? 'aa' : 'lim'}`}>{res}</span></td></tr>)}</tbody></table>
      <p class="note">AA = 4.5:1 for normal text, 3:1 for large text, icons and UI shapes.</p>
    </div>
  </details>
</div>

<div class="block">
  <h3 class="block-title">Fonts</h3>
  <div class="fonts">
    <div class="font-card">
      <span class="eyebrow">Headings · 600 / 700 / 800</span>
      <p class="font-big jak">Plus Jakarta Sans</p>
      <p class="font-glyphs jak">Aa Ää Éé Çç 0123456789</p>
      <p class="font-why">Modern, warm, premium; distinctive at large sizes; full DE/FR accents.</p>
    </div>
    <div class="font-card">
      <span class="eyebrow">UI + body · 400 / 500 / 600</span>
      <p class="font-big int">Inter</p>
      <p class="font-glyphs int tnum">CHF 1'234.50 · Sa, 10.07.2027</p>
      <p class="font-why">Made for screens, very readable at 12-16 px; tabular numbers ("tnum") and single-storey a off ("cv11") for amounts and dates.</p>
    </div>
  </div>
  <p class="note">Both free (SIL Open Font License), self-hosted with @fontsource (variable woff2, latin + latin-ext), not from the Google Fonts CDN: no visitor IPs sent to Google, and faster. About 60-90 KB total. This page uses exactly that setup.</p>
</div>

<div class="block">
  <h3 class="block-title">Type scale per app</h3>
  <div class="specs">
    {specs.map((s) => (
      <article class="spec">
        <header><b>{s.app}</b><span>{s.base}</span></header>
        <ul>
          {s.rows.map(([name, f, size, lh, w, sample]) => (
            <li>
              <span class="sp-meta"><span class="mono">{name}</span><span>{f === 'head' ? 'Jakarta' : 'Inter'} {size}/{lh} · {w}</span></span>
              <span class={`sp-sample${f === 'num' ? ' tnum' : ''}`} style={`font-family:${fam(f)};font-size:${size}px;line-height:${lh}px;font-weight:${w};letter-spacing:${f === 'head' ? (name === 'display' || name === 'Title' ? '-0.03em' : '-0.02em') : '0'}`}>{sample}</span>
            </li>
          ))}
        </ul>
      </article>
    ))}
  </div>
</div>

<div class="block">
  <h3 class="block-title">Spacing, shape, elevation</h3>
  <div class="grid grid-3 shape">
    <div class="card">
      <span class="eyebrow">Spacing · 4 px grid</span>
      <div class="spaces">{[4, 8, 12, 16, 20, 24, 32, 40, 48, 64, 80].map((n) => <div><i style={`width:${n}px`}></i><span class="mono">{n}</span></div>)}</div>
    </div>
    <div class="card">
      <span class="eyebrow">Radius family</span>
      <div class="radii">{[['6', 'chips, tags'], ['10', 'buttons, inputs'], ['14', 'cards, panels'], ['20', 'sheets, modals'], ['full', 'pills, avatars']].map(([r, u]) => <div><i style={`border-radius:${r === 'full' ? '999px' : r + 'px'}`}></i><b class="mono">{r}</b><span>{u}</span></div>)}</div>
    </div>
    <div class="card">
      <span class="eyebrow">Elevation · borders do most of the work</span>
      <div class="elev">{[['0', '1 px border, no shadow'], ['1', 'cards (Guest / Owner)'], ['2', 'popovers, raised'], ['3', 'modals, sheets']].map(([l, u]) => <div class={`e e${l}`}><b>level {l}</b><span>{u}</span></div>)}</div>
    </div>
  </div>
</div>

<div class="block">
  <h3 class="block-title">Component sheet</h3>
  <div class="sheet">
    <div class="cs">
      <span class="cs-h">Buttons · primary, all states</span>
      <div class="btns">
        <span class="b b-primary">Pay now</span>
        <span class="b b-primary hover">Hover</span>
        <span class="b b-primary pressed">Pressed</span>
        <span class="b b-primary focus">Focus</span>
        <span class="b b-primary disabled">Disabled</span>
        <span class="b b-primary loading" aria-label="Loading"><i class="spin"></i><span class="ghost-label">Pay now</span></span>
      </div>
      <div class="btns">
        <span class="b b-secondary">Secondary</span>
        <span class="b b-ghost">Ghost</span>
        <span class="b b-danger">Cancel stay</span>
      </div>
      <p class="cs-note">Heights: Guest 52 px (full width on mobile), Owner 44 px, Back Office 36 px. Loading keeps the width.</p>
    </div>
    <div class="cs">
      <span class="cs-h">Inputs</span>
      <label class="in-l">First name<span class="in">Anna</span></label>
      <label class="in-l">Email<span class="in focus">anna@example.ch</span></label>
      <label class="in-l">Date of birth<span class="in error">31.02.1990</span><em class="in-err">This date doesn't exist. Check day and month.</em></label>
    </div>
    <div class="cs">
      <span class="cs-h">Status pills · colour + dot + word</span>
      <div class="pills">
        <span class="pill pill-success">Paid</span><span class="pill pill-open">Payment pending</span>
        <span class="pill pill-danger">Failed</span><span class="pill pill-verify">Syncing</span>
      </div>
      <span class="cs-h">Stepper</span>
      <div class="stepper"><div class="st-bar"><i style="width:40%"></i></div><span>Step 2 of 5 · Companions</span></div>
      <span class="cs-h">KPI tile · Back Office</span>
      <div class="kpi"><span class="kpi-l">Check-ins missing</span><span class="kpi-v tnum">3</span><span class="kpi-s"><i></i>arrivals today</span></div>
    </div>
    <div class="cs">
      <span class="cs-h">Calendar · own use, friends, guest, high season</span>
      <div class="cal">
        <div class="cal-hs"></div>
        {Array.from({ length: 14 }, (_, i) => <span class={`d${i === 3 ? ' today' : ''}`}>{i + 6}</span>)}
        <div class="blk own" style="grid-column: 2 / 6">Own use</div>
        <div class="blk fr" style="grid-column: 9 / 12">Friends</div>
        <div class="blk gu" style="grid-column: 12 / 15"><i></i>Guest</div>
      </div>
      <p class="cs-note">40 px cells, rounded stay blocks, vivid channel dot, high-season band with a 2 px sun-500 line, today with a primary-600 ring.</p>
    </div>
  </div>
  <p class="note">Sample content for illustration only.</p>
</div>

<div class="block">
  <h3 class="block-title">Three apps, one system</h3>
  <div class="minis">
    <figure class="mini">
      <div class="m-phone">
        <div class="mp-top"><Icon name="chevron-left" size={16} /> Check-in</div>
        <div class="mp-prog"><i style="width:40%"></i></div>
        <p class="mp-step">Step 2 of 5</p>
        <p class="mp-h">Your companions</p>
        <div class="mp-card"><b>Lea Müller</b><span>Adult · Swiss</span></div>
        <div class="mp-card"><b>Noah Müller</b><span>Child 6-15 · Swiss</span></div>
        <div class="mp-add"><Icon name="plus" size={16} /> Add companion</div>
        <div class="mp-btn">Continue</div>
      </div>
      <figcaption>Guest check-in · light</figcaption>
    </figure>
    <figure class="mini">
      <div class="m-owner">
        <div class="mo-h"><b>My calendar</b><span>A3 · 2027</span></div>
        <div class="mo-q">
          <div><span>Year</span><b class="tnum">34 / 120</b><i><s style="width:28%"></s></i></div>
          <div><span>High season</span><b class="tnum">14 / 40</b><i><s style="width:35%"></s></i></div>
        </div>
        <div class="mo-cal">
          {Array.from({ length: 28 }, (_, i) => <span class={i >= 4 && i <= 10 ? 'own' : i >= 15 && i <= 17 ? 'fr' : i >= 20 && i <= 25 ? 'gu' : ''}></span>)}
        </div>
        <div class="mo-key"><span><i class="own"></i>own use</span><span><i class="fr"></i>friends</span><span><i class="gu"></i>guests</span></div>
      </div>
      <figcaption>Owner calendar · light</figcaption>
    </figure>
    <figure class="mini wide">
      <div class="m-bo">
        <div class="mb-side"><b>Picobello</b>{['Today', 'Stays', 'Calendar', 'Apartments', 'Owners', 'Money'].map((n, i) => <span class={i === 0 ? 'on' : ''}>{n}</span>)}</div>
        <div class="mb-main">
          <b class="mb-h">Today</b>
          <div class="mb-kpis">
            {[['Arrivals', '6'], ['Departures', '4'], ['Check-ins missing', '3'], ['Failed integrations', '1']].map(([l, v], i) => <div><span>{l}</span><b class="tnum">{v}</b>{i === 3 && <i class="dot-d"></i>}{i === 2 && <i class="dot-w"></i>}</div>)}
          </div>
          <table class="mb-t">
            <tbody>
              <tr><td class="mono">4335-2</td><td>Arrival 16:00</td><td><span class="pill pill-success">Checked in</span></td></tr>
              <tr><td class="mono">3078-6</td><td>Arrival 16:00</td><td><span class="pill pill-open">Payment pending</span></td></tr>
              <tr><td class="mono">3078-11</td><td>Departure 10:00</td><td><span class="pill pill-neutral">Card ready</span></td></tr>
            </tbody>
          </table>
        </div>
      </div>
      <figcaption>Back Office Today · light</figcaption>
    </figure>
    <figure class="mini">
      <div class="m-phone dark">
        <div class="mp-photo"></div>
        <div class="mp-ok"><Icon name="check" size={18} /></div>
        <p class="mp-h">Your badge is ready.</p>
        <p class="mp-p">Collect it at the machine next to the entrance.</p>
        <div class="mp-card"><b>Access</b><span>Today 16:00 → Sun 10:00</span></div>
        <div class="mp-btn">How to collect</div>
      </div>
      <figcaption>Guest App · dark</figcaption>
    </figure>
  </div>
  <p class="note">Sample names, units and numbers for illustration only.</p>
</div>

<div class="block">
  <h3 class="block-title">Avoid vs do · craft rules</h3>
  <div class="table-wrap">
    <table class="data avd">
      <thead><tr><th><Icon name="x" size={14} /> Avoid (generic)</th><th><Icon name="check" size={14} /> Do (crafted)</th></tr></thead>
      <tbody>{avoid.map(([a, d]) => <tr><td>{a}</td><td>{d}</td></tr>)}</tbody>
    </table>
  </div>
  <details class="disclose senior">
    <summary>Senior-level details we deliberately include<span class="count">11</span><Icon name="chevron-right" size={18} class="chev" /></summary>
    <div class="disclose-body">
      <ul class="list compact">
        <li>Tabular numbers wherever money and dates appear; amounts right-aligned; "CHF" in ink-muted, the number in ink.</li>
        <li>Optical alignment: icons nudged to the text cap height; 8 px icon-to-label gap.</li>
        <li>Every interactive element has hover, focus-visible, active, disabled and loading states.</li>
        <li>Forms: inline validation on blur, helpful errors, smart defaults from the booking, Enter submits, autofocus.</li>
        <li>Relative dates where it helps ("in 3 days", "today 16:00"), absolute on hover.</li>
        <li>No layout shift: images with fixed aspect ratio, buttons keep width while loading.</li>
        <li>Keyboard first in Back Office (Cmd+K, J/K in lists, Esc closes).</li>
        <li>Thoughtful empty, error and offline screens (Guest App shows cached apartment info offline).</li>
        <li>Micro-copy reviewed by a native speaker in DE / FR / EN.</li>
        <li>Reduced motion and larger text respected; visual QA on iPhone, Android, Windows, macOS.</li>
        <li>Quality bar: the calm density of Linear, the clarity of the Stripe Dashboard, the guest friendliness of Airbnb's trip screens. Inspiration for quality, not copied layouts.</li>
      </ul>
    </div>
  </details>
</div>

<div class="block">
  <h3 class="block-title">Style per app</h3>
  <div class="grid grid-3 perapp">
    <div class="card"><b>Guest App</b><p>Photo-led, snow background, large type, one vivid primary button per screen, bottom navigation, cards, alpenglow moments for welcome / success.</p></div>
    <div class="card"><b>Owner Portal</b><p>Same bright style, calendar-centred, medium density, big confident numbers.</p></div>
    <div class="card"><b>Back Office</b><p>Neutral stone background, compact tables, left sidebar, vivid colour only for status and actions.</p></div>
  </div>
  <p class="note">Formatting: money "CHF 1'234.50" (de-CH); dates de-CH "Sa, 10.07.2027", fr-CH "sam. 10.07.2027", en "Sat, 10 Jul 2027"; 24 h times; Swiss German spelling (ss, no ß), formal "Sie". Motion 150-200 ms ease-out, off with reduced motion. Icons: Lucide, 1.75 px stroke.</p>
