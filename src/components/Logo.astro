---
// Picobello mark (alpenglow peak) + wordmark. accent-500 is used for the
// logo mark per arch/13 section 2.2.
interface Props { size?: number }
const { size = 26 } = Astro.props;
---
<span class="logo">
  <svg width={size} height={size} viewBox="0 0 28 28" aria-hidden="true">
    <rect width="28" height="28" rx="7" fill="var(--accent-500)" />
    <path d="M5 20.5 11.2 10.6l3.6 5.4 2.4-3.2 5.8 7.7Z" fill="var(--ink)" />
    <path d="m11.2 10.6 1.9 2.9-1.9-.9-1.6 1Z" fill="var(--surface)" />
  </svg>
  <span class="word">Picobello</span>
</span>
<style>
  .logo { display: inline-flex; align-items: center; gap: 10px; }
  .word { font-family: var(--font-head); font-weight: 800; font-size: 1.125rem; letter-spacing: -0.02em; color: var(--primary-900); }
</style>
