---
import type { SectionMeta } from '../data/sections';
interface Props { meta: SectionMeta }
const { meta } = Astro.props;
---
<section class="section" id={meta.id} data-section aria-labelledby={`${meta.id}-title`}>
  <header class="section-head">
    <h2 id={`${meta.id}-title`}>{meta.title}</h2>
    <p class="question"><b>{meta.leadLabel}:</b> {meta.lead}</p>
  </header>
  <slot>
    <div class="todo"><strong>Visuals for this section arrive in build step {meta.step}.</strong> Heading and question are final.</div>
  </slot>
</section>
