---
// Phase 1 Gantt: 2 Nov 2026 -> 17 Jan 2027 to scale, plus a compressed
// tail for Phase 1b (guest journey, to 15 Apr). Waves and milestones from arch/15
// (summary of Architektur/nextsteps.md).
interface Props { label: string; showBuffer?: boolean }
const { showBuffer = true } = Astro.props;

const LX = 310, X1 = 1060, TAIL = 1080;
const start = Date.UTC(2026, 10, 2);
const end = Date.UTC(2027, 0, 17);
const day = (m: number, d: number) => Date.UTC(m >= 10 ? 2026 : 2027, m, d);
const x = (m: number, d: number) => LX + ((day(m, d) - start) / (end - start)) * (X1 - LX);

const rows: { label: string; sub: string; a: [number, number]; b: [number, number]; ms?: string; tone?: string }[] = [
  { label: 'Architecture review', sub: 'M0 · 5 Nov', a: [10, 5], b: [10, 6], ms: 'M0', tone: 'review' },
  { label: 'W0 Baseline, local setup', sub: '5-7 Nov', a: [10, 5], b: [10, 8] },
  { label: 'W2a Module pattern, M1', sub: '9-13 Nov · on localhost', a: [10, 9], b: [10, 16], ms: 'M1' },
  { label: 'W2b Async backbone, mail', sub: '12-16 Nov', a: [10, 12], b: [10, 17] },
  { label: 'W3 Stays, Lodgify read, ledger', sub: '16-22 Nov', a: [10, 16], b: [10, 23] },
  { label: 'W4 Owner reservations', sub: '23-29 Nov · rules, Lodgify write', a: [10, 23], b: [10, 30], ms: 'M2' },
  { label: 'WD First deploy: staging', sub: '23-27 Nov · limit 30 Nov', a: [10, 23], b: [10, 28], tone: 'review' },
  { label: 'W5 Ledger, Feratel, Today', sub: '30 Nov-11 Dec', a: [10, 30], b: [11, 14], ms: 'M3' },
  { label: 'W6 Production platform', sub: '30 Nov-16 Dec · infra only', a: [10, 30], b: [11, 17] },
  { label: 'W7 Apartments, Archipex', sub: '14-20 Dec', a: [11, 14], b: [11, 21], ms: 'M4' },
  { label: 'W8 Hardening, readiness', sub: '14 Dec-4 Jan', a: [11, 14], b: [0, 5], ms: 'M5' },
  { label: 'G Go-live: bookings live', sub: '5-10 Jan · hypercare to 24 Jan', a: [0, 5], b: [0, 11], ms: 'M6', tone: 'go' },
];
const ms: { id: string; m: number; d: number; t: string }[] = [
  { id: 'M0', m: 10, d: 5, t: '5 Nov' }, { id: 'M1', m: 10, d: 15, t: '15 Nov' }, { id: 'M2', m: 10, d: 29, t: '29 Nov' },
  { id: 'M3', m: 11, d: 13, t: '13 Dec' }, { id: 'M4', m: 11, d: 20, t: '20 Dec' }, { id: 'M5', m: 0, d: 5, t: '5 Jan' }, { id: 'M6', m: 0, d: 10, t: '10 Jan' },
];
const mondays: number[][] = [];
for (let t = start; t <= end; t += 7 * 86400000) { const dt = new Date(t); mondays.push([dt.getUTCMonth(), dt.getUTCDate()]); }
const TOP = 96, RH = 46;
const H = TOP + rows.length * RH + 70;
const mx = (m: number, d: number) => x(m, d + 1); // milestones mark the end of their day
---
<svg viewBox={`0 0 1200 ${H}`} xmlns="http://www.w3.org/2000/svg" class="gantt"
  data-start={start} data-end={end} data-x0={LX} data-x1={X1} data-top={TOP} data-bottom={TOP + rows.length * RH}>
  {showBuffer && (
    <g>
      <rect x={x(11, 24)} y={TOP - 30} width={x(0, 5) - x(11, 24)} height={rows.length * RH + 30} fill="url(#hatch)" opacity="0.55" />
      <text x={(x(11, 24) + x(0, 5)) / 2} y={TOP + rows.length * RH + 22} text-anchor="middle" class="g-buffer">Holidays: production checks only, all build work merged by 23 Dec</text>
    </g>
  )}
  {mondays.map(([m, d]) => (
    <g>
      <line x1={x(m, d)} x2={x(m, d)} y1={TOP - 30} y2={TOP + rows.length * RH} class="g-grid" />
      <text x={x(m, d) + 4} y={TOP - 36} class="g-tick">{d} {['Jan', '', '', '', '', '', '', '', '', '', 'Nov', 'Dec'][m]}</text>
    </g>
  ))}

  {ms.map((s) => (
    <g>
      <path d={`M${mx(s.m, s.d)} ${30} l9 9 -9 9 -9 -9z`} class={s.id === 'M6' ? 'g-ms go' : 'g-ms'} />
      <text x={mx(s.m, s.d)} y="22" text-anchor="middle" class="g-ms-t">{s.id}</text>
    </g>
  ))}

  {rows.map((r, i) => {
    const y = TOP + i * RH;
    const xa = x(r.a[0], r.a[1]), xb = x(r.b[0], r.b[1]);
    return (
      <g>
        <line x1="20" x2={X1} y1={y + RH} y2={y + RH} class="g-row" />
        <text x="20" y={y + 20} class="g-label">{r.label}</text>
        <text x="20" y={y + 38} class="g-sub">{r.sub}</text>
        <rect x={xa} y={y + 12} width={Math.max(6, xb - xa - 2)} height="22" rx="6" class={`g-bar ${r.tone ?? ''}`} />
        {r.ms && <path d={`M${xb - 1} ${y + 12} l11 11 -11 11 -11 -11z`} class={r.ms === 'M6' ? 'g-ms go' : 'g-ms'} />}
      </g>
    );
  })}

  <!-- tail: Phase 2 -->
  <path d={`M${X1 + 6} ${TOP - 30} l6 -6 m-6 12 l6 -6`} class="g-break" />
  <rect x={TAIL} y={TOP + 12} width={1190 - TAIL} height={rows.length * RH - 24} rx="10" class="g-p2" />
  <text x={(TAIL + 1190) / 2} y={TOP + rows.length * RH / 2 - 16} text-anchor="middle" class="g-p2-t">Phase 1b</text>
  <text x={(TAIL + 1190) / 2} y={TOP + rows.length * RH / 2 + 6} text-anchor="middle" class="g-p2-s">guests</text>
  <text x={(TAIL + 1190) / 2} y={TOP + rows.length * RH / 2 + 26} text-anchor="middle" class="g-p2-s">→ M7</text>
  <text x={(TAIL + 1190) / 2} y={TOP + rows.length * RH / 2 + 46} text-anchor="middle" class="g-p2-s">15 Apr</text>
</svg>

<style>
  .g-grid { stroke: var(--line); stroke-width: 1; }
  .g-row { stroke: var(--line); stroke-width: 1; }
  .g-tick { font-size: 13px; fill: var(--ink-muted); font-variant-numeric: tabular-nums; }
  .g-label { font-size: 16px; font-weight: 600; fill: var(--ink); }
  .g-sub { font-size: 13.5px; fill: var(--ink-muted); }
  .g-bar { fill: var(--primary-600); }
  .g-bar.review { fill: var(--ink); }
  .g-bar.go { fill: var(--primary-800); }
  .g-ms { fill: var(--surface); stroke: var(--primary-800); stroke-width: 1.75; }
  .g-ms.go { fill: var(--accent-500); stroke: var(--surface); stroke-width: 2; }
  .g-ms-t { font-size: 13px; font-weight: 700; fill: var(--primary-800); }
  .g-buffer { font-size: 13.5px; font-weight: 500; fill: var(--ink-muted); }
  .g-break { stroke: var(--ink-faint); stroke-width: 1.5; fill: none; }
  .g-p2 { fill: var(--surface-2); stroke: var(--ink-faint); stroke-dasharray: 5 4; }
  .g-p2-t { font-size: 15px; font-weight: 600; fill: var(--ink-muted); }
  .g-p2-s { font-size: 13px; fill: var(--ink-muted); }
</style>
